{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "allowJs": true, "checkJs": false, "noEmit": true, "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "paths": {"@/*": ["./*"]}
  },
  "include": ["app", "components", "lib", "main.tsx", "vite.config.ts"]
}
